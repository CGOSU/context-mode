{
  "name": "context-mode",
  "version": "2.1.10",
  "type": "module",
  "description": "MCP plugin that saves 98% of your context window. Works with Claude Code, Gemini CLI, VS Code Copilot, OpenCode, and Codex CLI. Sandboxed code execution, FTS5 knowledge base, and intent-driven search.",
  "author": "Mert Koseoğlu",
  "license": "Elastic-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "gemini-cli",
    "vscode-copilot",
    "opencode",
    "openclaw",
    "codex-cli",
    "context-window",
    "sandbox",
    "code-execution",
    "fts5",
    "bm25",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mksglu/context-mode"
  },
  "homepage": "https://github.com/mksglu/context-mode#readme",
  "pi": {
    "extensions": [
      "./build/adapters/pi/extension.js"
    ],
    "skills": [
      "./configs/pi/skills/context-mode",
      "./skills/ctx-doctor",
      "./skills/ctx-index",
      "./skills/ctx-insight",
      "./skills/ctx-purge",
      "./skills/ctx-search",
      "./skills/ctx-stats",
      "./skills/ctx-upgrade"
    ]
  },
  "bugs": "https://github.com/mksglu/context-mode/issues",
  "main": "./build/adapters/pi/extension.js",
  "exports": {
    ".": "./build/adapters/pi/extension.js",
    "./cli": "./cli.bundle.mjs"
  },
  "bin": {
    "context-mode": "./cli.bundle.mjs"
  },
  "files": [
    "build",
    "configs/pi",
    "server.bundle.mjs",
    "cli.bundle.mjs",
    "skills",
    "scripts/postinstall.mjs",
    "scripts/heal-better-sqlite3.mjs",
    "scripts/sqlite-health.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"if(process.platform!=='win32'){require('fs').chmodSync('build/cli.js',0o755)}\" && npm run bundle && npm run assert-bundle",
    "assert-bundle": "node scripts/assert-bundle.mjs server.bundle.mjs cli.bundle.mjs build/adapters/pi/extension.js",
    "bundle": "node scripts/build-pi.mjs && esbuild src/cli.ts --bundle --platform=node --target=node18 --format=esm --outfile=cli.bundle.mjs --external:better-sqlite3 --minify",
    "bundle:pi": "node scripts/build-pi.mjs --extension-only",
    "build:pi": "node scripts/build-pi.mjs && node scripts/assert-bundle.mjs server.bundle.mjs build/adapters/pi/extension.js",
    "version-sync": "node scripts/version-sync.mjs",
    "version": "node scripts/version-sync.mjs && git add package.json",
    "prepublishOnly": "npm run build",
    "dev": "npx tsx src/server.ts",
    "setup": "npx tsx src/cli.ts setup",
    "doctor": "npx tsx src/cli.ts doctor",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "npx tsx tests/benchmark.ts",
    "test:use-cases": "npx tsx tests/use-cases.ts",
    "test:compare": "npx tsx tests/context-comparison.ts",
    "test:ecosystem": "npx tsx tests/ecosystem-benchmark.ts",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@mixmark-io/domino": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "13.0.3",
    "picocolors": "^1.1.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.11",
    "@types/turndown": "^5.0.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b",
  "engines": {
    "node": ">=22.5.0"
  }
}
